@@ -483,7 +440,6 @@
 		fi
 
 		cat >>"$tmp" <<EOF
-
 		# Everything else is local: it must not reach the operator path.
 		iifname "$uplink_ref" counter drop comment "drop-non-pppoe-from-uplink"
 		oifname "$uplink_ref" counter drop comment "drop-non-pppoe-to-uplink"
@@ -491,12 +447,10 @@
 	}
 
 	chain forward {
-		type filter hook forward priority filter - 1; policy accept;
+		type filter hook forward priority filter; policy accept;
 
 		# The bridge hook sees every bridge; this match scopes the filter.
 		meta ibrname "$BRIDGE_DEV" jump wanup_forward
-		meta ibrname "$BRIDGE_DEV" meta l4proto { tcp, udp } \
-			flow offload @wanup_ft comment "internet-bridge-hw-offload"
 	}
 }
