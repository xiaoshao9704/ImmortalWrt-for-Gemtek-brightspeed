+	# a missing/inconsistent stamp triggers firewall reload instead of a blind mark.
+	if nft_file_is filter && nft_rules_ok "$NFT_FILE"; then
+		tmp="$(stage_nft_file)" || {
+			warn "internet bridge nft reprobe: cannot stage rules"
+			return 0
+		}
