+# Shared exclusive lock for every writer of /etc/internet.nft (LuCI apply and
+# wan ifup reprobe). Nested callers that already hold it are no-ops.
+nft_file_lock() {
+	local lockfile
+
+	[ "${NFT_FILE_LOCK_HELD:-0}" -eq 1 ] && return 0
+	lockfile="${NFT_REPROBE_LOCK:-/var/lock/internet-nft-reprobe.lock}"
+	mkdir -p "$(dirname "$lockfile")" 2>/dev/null || true
+	exec 8>"$lockfile" || return 1
+	flock 8 || return 1
+	NFT_FILE_LOCK_HELD=1
+}
+
+# Stamp of the ruleset last successfully loaded into the kernel via firewall
+# reload. A failed reload clears the stamp so the next wan ifup retries instead
+# of treating the on-disk file as already live. Never mark loaded without a
+# successful reload (or an equivalent kernel verification).
+nft_loaded_stamp() {
+	printf '%s' "${NFT_LOADED_STAMP:-/var/run/internet-nft.loaded}"
+}
+
+nft_mark_loaded() {
+	local stamp
+
+	stamp="$(nft_loaded_stamp)"
+	mkdir -p "$(dirname "$stamp")" 2>/dev/null || true
+	printf '%s\n' "$1" >"$stamp"
+}
+
+nft_clear_loaded() {
+	rm -f "$(nft_loaded_stamp)"
+}
+
+nft_loaded_is() {
+	local stamp
+
+	stamp="$(nft_loaded_stamp)"
+	[ -f "$stamp" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$1" ]
+}
+
+nft_file_is() {
+	[ -f "$NFT_FILE" ] &&
+		grep -qx "# internet-apply bridge ruleset: $1" "$NFT_FILE"
+}
+
+# Install $2 when the on-disk file is not already this ruleset, then reload
+# firewall4. Only a successful reload stamps the ruleset as loaded; a failed
+# reload clears the stamp so the next reprobe retries. Always returns 0:
+# hotplug must not abort later iface scripts. Caller must hold nft_file_lock.
+commit_probed_rules() {
+	local ruleset="$1" tmp="$2" changed=0
+
+	if nft_file_is "$ruleset" && nft_rules_ok "$NFT_FILE"; then
+		rm -f "$tmp"
+	else
+		install_nft_file "$tmp" "$ruleset"
+		changed=1
+	fi
+	NFT_RULESET="$ruleset"
+
+	if nft_loaded_is "$ruleset" && [ "$changed" -eq 0 ]; then
+		return 0
+	fi
+
+	# Stamp missing or inconsistent with disk: always reload. Do not blind-mark
+	# filter as loaded just because the file is already on disk (START=18 may
+	# have written it without a successful firewall reload into the kernel).
+	if /etc/init.d/firewall reload; then
+		nft_mark_loaded "$ruleset"
+		if [ "$changed" -eq 1 ] && [ "$ruleset" = 'full' ]; then
+			logger -t internet "internet bridge nft upgraded to full rules (flowtable)"
+		elif [ "$changed" -eq 1 ]; then
+			logger -t internet "internet bridge nft kept on PPPoE/IPoE filter fallback"
+		else
+			logger -t internet "internet bridge nft reloaded $ruleset rules"
+		fi
+		return 0
+	fi
+
+	nft_clear_loaded
+	warn "firewall reload of internet bridge $ruleset rules failed; the next wan ifup retries"
+	return 0
+}
+
+# Called after netifd has created the bridge devices. Rewrites only the nft
