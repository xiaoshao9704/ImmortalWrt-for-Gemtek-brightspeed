#!/bin/sh

# Default XG2010G to Chinese; retain an explicitly saved language choice.
case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
	gemtek,xg2010g|gemtek,xg2010g-ubi|gemtek,xg2010g-2g-ubi) ;;
	*) exit 0 ;;
esac

[ -f /etc/config/luci ] || exit 0
case "$(uci -q get luci.main.lang)" in
	''|auto)
		uci set luci.main.lang='zh_cn' && uci commit luci
		;;
	*) exit 0 ;;
esac
