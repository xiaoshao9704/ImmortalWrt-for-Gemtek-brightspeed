# Runtime distfeeds lists only feeds that publish
# packages/<arch>/<feed>/packages.adb on the ImmortalWrt/OpenWrt snapshot
# tree: packages, luci, routing, telephony, and video (see DISTFEEDS_FEEDS
# in include/feeds.mk). Every other src-git line below is a build-time
# source. Its packages are still installed into the image, but the feed name
# is omitted from /etc/apk/repositories.d/distfeeds.list so `apk update`
# does not request a missing packages.adb.
src-git packages https://github.com/immortalwrt/packages.git^0a5212e0b37c019df5a152553e571378ec6c5dcc
src-git luci https://github.com/immortalwrt/luci.git^05c955f0aca2f5e8de1c126b0ec9e9e677e83b3f
#src-git --directory=luci-theme-glass glass https://github.com/rchen14b/luci-theme-glass.git;main
src-git routing https://github.com/openwrt/routing.git^4b9891b9136259f93294a424507ed24c5e8c1cbd
src-git telephony https://github.com/openwrt/telephony.git^67281dfcb4f2beee48af0cbf689a71d96f3ce339
#src-git video https://github.com/openwrt/video.git
src-git app_airoha https://github.com/naoki66/luci-app-airoha.git^b56842cac5f336445df66c48fcae5c0282fdafe8
src-git pon_drivers https://github.com/naoki66/openwrt-pon-drivers.git^e19bde08ac3f3218a783f22165d9a5ded06046d2
src-git onu_config https://github.com/naoki66/OpenWrt_ONU_CONFIG.git^3cb13560459f1d51136dac662baa1f399028b2b4
#src-git targets https://github.com/openwrt/targets.git
#src-git oldpackages http://git.openwrt.org/packages.git
#src-link custom /usr/src/openwrt/custom-feed
src-git easytier https://github.com/EasyTier/luci-app-easytier.git^9c51d3f8d2bfcefd039f2ff2354c6a7674293a06
src-git openwrt_bandix https://github.com/timsaya/openwrt-bandix.git^c95b03d40b30c31e89c090aaf134750f05bf3f19
src-git luci_app_bandix https://github.com/timsaya/luci-app-bandix.git^9a89d40957e69df834bc42cc4d08555e25c670d5
src-git helloworld https://github.com/fw876/helloworld.git^31b180df838e456bb36036bb8791f569af0fd661
src-git --directory=luci-app-pushbot pushbot https://github.com/naoki66/luci-app-pushbot.git^d9f3f2b16584b5f040658ebb9d6c3e656fbec9b5
